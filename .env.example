PROTOSKIN_SDXL=models/sdxl-base-1.0
PROTOSKIN_CONTROLNET=models/controlnet-canny-sdxl
PROTOSKIN_LLM=models/qwen3-8b
# 3D preview: TripoSG (MIT) weights and vendored source (see
# third_party/README.md for the one patch applied and why).
PROTOSKIN_TRIPOSG=models/TripoSG
PROTOSKIN_TRIPOSG_SRC=third_party/TripoSG
# TripoSG runs in its own Python environment (scripts/setup_3d_env.sh):
# it needs diffusers/transformers versions that differ from the main app's.
PROTOSKIN_3D_PYTHON=envs/protoskin3d-os/bin/python
# Optional 3D quality/speed knobs (read by the 3D service). Defaults shown,
# tuned for ~15s per mesh on the ZGX Nano: 20 flow steps, a dense 128^3
# grid (depth 7) refined to 256^3 (depth 8) near the surface. TripoSG's own
# defaults (50 steps, depth 8 -> 9) take ~60s for a near-identical mesh.
# Fewer than ~16 steps produces broken shapes.
# PROTOSKIN_3D_STEPS=20
# PROTOSKIN_3D_DENSE_DEPTH=7
# PROTOSKIN_3D_OCTREE_DEPTH=8
# PROTOSKIN_3D_FACES=250000
# PROTOSKIN_3D_TIMEOUT_S=180
