PROTOSKIN_SDXL=models/sdxl-base-1.0
PROTOSKIN_CONTROLNET=models/controlnet-canny-sdxl
PROTOSKIN_LLM=models/qwen3-8b
PROTOSKIN_SF3D=models/stable-fast-3d
# Stable Fast 3D needs its own Python environment (see
# scripts/setup_sf3d_env.sh): its pinned deps conflict with the LLM's
# transformers version. Point this at that environment's python binary.
PROTOSKIN_SF3D_PYTHON=envs/protoskin3d/bin/python
# Vendored, patched Stable Fast 3D source (see third_party/README.md for
# what's patched and why). Only needed by the sidecar 3D service.
PROTOSKIN_SF3D_SRC=third_party/stable-fast-3d
